{
  "name": "@where-the-record-ends/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace=@where-the-record-ends/genealogy-content",
    "dev": "next dev",
    "prebuild": "npm run build --workspace=@where-the-record-ends/genealogy-content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "pretype-check": "npm run build --workspace=@where-the-record-ends/genealogy-content",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.25",
    "@vercel/functions": "^3.9.9",
    "@where-the-record-ends/genealogy-content": "*",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.25",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  }
}
