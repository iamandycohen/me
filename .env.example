# Environment Variables
# Copy to .env.local and customize as needed.
# The site has no required environment variables — all are optional.

# Canonical site URL (used for OpenGraph, sitemap, llms.txt, etc.)
# NEXT_PUBLIC_SITE_URL=https://www.iamandycohen.com

# Google Analytics measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
